{{define "coverage_index.html.tmpl"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Coverage</title>
{{template "styles"}}
</head>
<body>
<div class="wrap">
  <p class="crumbs"><a href="../index.html">← Report</a> / Coverage</p>
  <header class="top"><h1>Coverage</h1><span class="pill g-{{.LineGrade}}" style="font-size:20px">{{pct1 .Summary.Lines.Pct}}</span></header>
  <div class="sub">test-cli {{.ToolVersion}} · generated {{.GeneratedAt}} · {{.Summary.Lines.Covered}}/{{.Summary.Lines.Total}} lines{{if gt .Summary.Branches.Total 0}} · branches {{pct1 .Summary.Branches.Pct}}{{end}}</div>

  <nav class="report-nav"><a href="../index.html">Overview</a><a href="../insights.html">QA insights</a><strong>Coverage maps</strong></nav>

  {{if .Files}}
  <section>
    <h2>Coverage treemap · size = executable lines, color = coverage</h2>
    <div class="treemap">
      {{range .Files}}
      <a class="tree-tile g-bg-{{.Grade}}" href="{{.Slug}}" style="flex-grow:{{.Weight}}" title="{{.Path}} · {{.Pct}} · {{.Uncovered}} uncovered lines">
        <strong>{{.Label}}</strong><span>{{.Pct}}</span><small>{{.Uncovered}} uncovered</small>
      </a>
      {{end}}
    </div>
  </section>
  {{end}}

  {{if .Tree}}
  <section>
    <h2>Directory coverage tree</h2>
    <table class="coverage-tree">
      <thead><tr><th>Path</th><th class="num">Files</th><th>Line coverage</th><th class="num">Branches</th></tr></thead>
      <tbody>
      {{range .Tree}}
        <tr class="{{if .IsDir}}dir-row{{else}}file-row{{end}}" data-depth="{{.Depth}}">
          <td style="padding-left:{{.Indent}}px">{{if .IsDir}}<button class="tree-toggle" type="button" aria-label="Collapse {{.Path}}" onclick="toggleTree(this.closest('tr'))">▾</button><strong title="{{.Path}}">{{.Label}}</strong>{{else}}<span class="tree-icon">·</span><a href="{{.Slug}}" title="{{.Path}}">{{.Label}}</a>{{end}}</td>
          <td class="num">{{if .IsDir}}{{.Files}}{{end}}</td>
          <td><div class="metric-inline"><div class="bar"><span class="g-{{.Grade}}" style="width:{{printf "%.0f" .PctNum}}%"></span></div><span class="pill g-{{.Grade}}">{{.Pct}}</span><span class="muted">{{.Covered}}/{{.Total}}</span></div></td>
          <td class="num">{{if gt .Branches.Total 0}}{{pct1 .Branches.Pct}}{{else}}—{{end}}</td>
        </tr>
      {{end}}
      </tbody>
    </table>
  </section>
  {{end}}

  <section>
    <h2>Files ({{len .Files}})</h2>
    <input class="filter" type="text" placeholder="Filter files…" onkeyup="filterRows(this.value)">
    <table id="files">
      <thead><tr><th>File</th><th style="width:38%">Coverage</th><th class="num">Lines</th><th class="num">Branches</th><th class="num">Uncovered</th></tr></thead>
      <tbody>
      {{range .Files}}
        <tr data-path="{{.Path}}">
          <td><a href="{{.Slug}}">{{.Path}}</a></td>
          <td>
            <div style="display:flex;align-items:center;gap:8px">
              <div class="bar" style="flex:1"><span class="g-{{.Grade}}" style="width:{{printf "%.0f" .PctNum}}%"></span></div>
              <span class="pill g-{{.Grade}}">{{.Pct}}</span>
            </div>
          </td>
          <td class="num">{{.Covered}}/{{.Total}}</td>
          <td class="num">{{if gt .Branches.Total 0}}{{pct1 .Branches.Pct}}{{else}}—{{end}}</td>
          <td class="num">{{.Uncovered}}</td>
        </tr>
      {{end}}
      </tbody>
    </table>
  </section>
  <footer>Generated by <a href="https://github.com/jhl-labs/test-cli">test-cli</a> · schema {{.Schema}}</footer>
</div>
<script>
function filterRows(q) {
  q = q.toLowerCase();
  document.querySelectorAll('#files tbody tr').forEach(function (tr) {
    var p = (tr.getAttribute('data-path') || '').toLowerCase();
    tr.style.display = p.indexOf(q) >= 0 ? '' : 'none';
  });
}
function toggleTree(row) {
  var depth = parseInt(row.getAttribute('data-depth') || '0', 10);
  var hide = !row.classList.contains('collapsed');
  row.classList.toggle('collapsed', hide);
  var button = row.querySelector('.tree-toggle');
  if (button) {
    button.textContent = hide ? '▸' : '▾';
    button.setAttribute('aria-label', (hide ? 'Expand ' : 'Collapse ') + (row.textContent || '').trim());
  }
  var next = row.nextElementSibling;
  while (next && parseInt(next.getAttribute('data-depth') || '0', 10) > depth) {
    next.style.display = hide ? 'none' : '';
    if (!hide) {
      next.classList.remove('collapsed');
      var childButton = next.querySelector('.tree-toggle');
      if (childButton) childButton.textContent = '▾';
    }
    next = next.nextElementSibling;
  }
}
</script>
</body>
</html>{{end}}
